POSTGRES_DB=zm_terminal
POSTGRES_USER=zm_terminal
POSTGRES_PASSWORD=zm_terminal_dev
# Application role (migrations 015-016). The Postgres container creates this role from these values and the API connects with the same
# ones, as a limited role that cannot truncate/drop/alter; it never uses the admin POSTGRES_USER. Change the password here only.
APP_DB_USER=zm_terminal_app
APP_DB_PASSWORD=zm_terminal_app_dev
# Optional override of the APP_DB_* settings above (wins when set; the admin role is refused). Leave unset with Compose.
# DATABASE_URL=postgresql+psycopg://zm_terminal_app:<password>@postgres:5432/zm_terminal
OPENBB_URL=http://openbb:6900
BOZ_USD_RATES_URL=https://www.boz.zm/api/v1/views/boz_zmw_usd_daily_exchange_rates
MOA_MEDIA_URL=https://www.agriculture.gov.zm/wp-json/wp/v2/media
MOA_CA_BUNDLE=
VITE_API_URL=http://localhost:8000
FRED_API_KEY=
